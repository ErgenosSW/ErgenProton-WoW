[Unit]
Description=ErgenProton WoW GameMode process supervisor
Documentation=https://github.com/ErgenosSW/ErgenProton-WoW
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u "%h/.local/lib/ergenwow-gamemode/wow_gamemode.py"
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Nice=10
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=graphical-session.target
